{
  "manifest_version": 3,
  "name": "BC atlaižu pārvaldnieks",
  "version": "2.2.1",
  "description": "Vieds palīgs AM Furnitūra darbiniekiem: saistītā klienta rindu atlaižu automātiska nolasīšana un piemērošana Microsoft Business Central.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://amfbc.amf.lv/*",
    "*://*.amf.lv/*",
    "https://amfbc.amf.lv:7048/*",
    "https://amfbc.amf.lv:8443/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://amfbc.amf.lv/*",
        "*://*.amf.lv/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://amfbc.amf.lv/*",
        "*://*.amf.lv/*"
      ]
    }
  ],
  "commands": {
    "open_discount_modal": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Atvērt BC atlaižu pārvaldnieku"
    }
  },
  "action": {
    "default_title": "BC atlaižu pārvaldnieks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
