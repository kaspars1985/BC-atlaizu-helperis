{
  "manifest_version": 3,
  "name": "BC atlaižu pārvaldnieks",
  "version": "2.2.6",
  "description": "Saistītā klienta rindu atlaižu automātiska nolasīšana un piemērošana Microsoft Dynamics 365 Business Central.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "commands": {
    "open_discount_modal": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Atvērt BC atlaižu pārvaldnieku"
    }
  },
  "action": {
    "default_title": "BC atlaižu pārvaldnieks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
